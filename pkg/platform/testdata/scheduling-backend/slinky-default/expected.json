{
  "jobTemplate": {
    "spec": {
      "backend": {
        "name": "slinky"
      },
      "workload": {
        "trainJob": {
          "runtimeRef": {
            "name": "nccl-all-reduce-runtime",
            "kind": "TrainingRuntime"
          },
          "trainer": {
            "numNodes": 2
          }
        }
      },
      "workloadMetadata": {
        "labels": {
          "slinky.slurm.net/partition": "slurm-bridge"
        }
      }
    }
  },
  "orchestration": {
    "execution": {}
  },
  "dependencies": [
    {
      "apiVersion": "trainer.kubeflow.org/v1alpha1",
      "kind": "TrainingRuntime",
      "metadata": {
        "name": "nccl-all-reduce-runtime"
      },
      "spec": {
        "mlPolicy": {
          "mpi": {
            "mpiImplementation": "OpenMPI",
            "numProcPerNode": 4
          },
          "numNodes": 2
        },
        "template": {
          "metadata": {
            "annotations": {
              "slurmjob.slinky.slurm.net/exclusive": "false",
              "slurmjob.slinky.slurm.net/partition": "slurm-bridge"
            }
          },
          "spec": {
            "replicatedJobs": [
              {
                "name": "node",
                "template": {
                  "metadata": {
                    "labels": {
                      "slinky.slurm.net/partition": "slurm-bridge"
                    }
                  },
                  "spec": {
                    "template": {
                      "metadata": {
                        "labels": {
                          "slinky.slurm.net/partition": "slurm-bridge"
                        }
                      },
                      "spec": {
                        "containers": [
                          {
                            "image": "nvcr.io/nvidia/pytorch:25.01",
                            "name": "node"
                          }
                        ],
                        "restartPolicy": "OnFailure",
                        "schedulerName": "slurm-bridge-scheduler"
                      }
                    }
                  }
                }
              },
              {
                "dependsOn": [
                  {
                    "name": "node",
                    "status": "Ready"
                  }
                ],
                "name": "launcher",
                "template": {
                  "metadata": {
                    "labels": {
                      "slinky.slurm.net/partition": "slurm-bridge"
                    }
                  },
                  "spec": {
                    "backoffLimit": 1,
                    "podFailurePolicy": {
                      "rules": [
                        {
                          "action": "Ignore",
                          "onPodConditions": [
                            {
                              "status": "True",
                              "type": "DisruptionTarget"
                            }
                          ]
                        }
                      ]
                    },
                    "template": {
                      "metadata": {
                        "labels": {
                          "slinky.slurm.net/partition": "slurm-bridge"
                        }
                      },
                      "spec": {
                        "containers": [
                          {
                            "image": "nvcr.io/nvidia/pytorch:25.01",
                            "name": "node"
                          }
                        ],
                        "restartPolicy": "Never",
                        "schedulerName": "slurm-bridge-scheduler"
                      }
                    }
                  }
                }
              }
            ]
          }
        }
      }
    }
  ],
  "gangScheduler": {
    "schedulerName": "slurm-bridge-scheduler",
    "queue": "slurm-bridge",
    "queueLabelKey": "slinky.slurm.net/partition"
  }
}