{
  "probe": {
    "apiVersion": "run.ai/v2alpha1",
    "kind": "TrainingWorkload",
    "metadata": {
      "labels": {
        "runai/queue": "test-queue"
      },
      "name": "probe",
      "namespace": "test"
    },
    "spec": {
      "backoffLimit": {
        "value": 0
      },
      "command": {
        "value": "'timeout' '--kill-after=10s' '900' 'python3' '/probe/probe.py'"
      },
      "configMapVolumes": {
        "items": {
          "probe": {
            "value": {
              "mountPath": "/probe",
              "name": "vllm-single-probe"
            }
          }
        }
      },
      "cpu": {
        "value": "0.1"
      },
      "environment": {
        "items": {
          "TIMEOUT_SECONDS": {
            "value": "600"
          },
          "VLLM_MODEL": {
            "value": "Qwen/Qwen2.5-0.5B-Instruct"
          },
          "VLLM_SERVICE": {
            "value": "vllm-single-service"
          }
        }
      },
      "gpuDevices": {
        "value": 0
      },
      "image": {
        "value": "python:3.12-slim"
      },
      "imagePullSecrets": {
        "value": "test-pull"
      },
      "memory": {
        "value": "64Mi"
      },
      "memoryLimit": {
        "value": "256Mi"
      },
      "restartPolicy": {
        "value": "Never"
      }
    }
  },
  "workflow": {
    "jobTemplate": {
      "spec": {
        "backend": {
          "name": "runai",
          "queue": "test-queue"
        },
        "workload": {
          "inference": {
            "activeDeadlineSeconds": 900,
            "backoffLimit": 0,
            "template": {
              "metadata": {},
              "spec": {
                "volumes": [
                  {
                    "name": "probe",
                    "configMap": {
                      "name": "vllm-single-probe"
                    }
                  }
                ],
                "containers": [
                  {
                    "name": "probe",
                    "image": "python:3.12-slim",
                    "command": [
                      "python3",
                      "/probe/probe.py"
                    ],
                    "env": [
                      {
                        "name": "VLLM_SERVICE",
                        "value": "vllm-single-service"
                      },
                      {
                        "name": "VLLM_MODEL",
                        "value": "Qwen/Qwen2.5-0.5B-Instruct"
                      },
                      {
                        "name": "TIMEOUT_SECONDS",
                        "value": "600"
                      }
                    ],
                    "resources": {
                      "limits": {
                        "memory": "256Mi"
                      },
                      "requests": {
                        "cpu": "100m",
                        "memory": "64Mi"
                      }
                    },
                    "volumeMounts": [
                      {
                        "name": "probe",
                        "readOnly": true,
                        "mountPath": "/probe"
                      }
                    ]
                  }
                ],
                "restartPolicy": "Never",
                "imagePullSecrets": [
                  {
                    "name": "test-pull"
                  }
                ]
              }
            }
          }
        },
        "workloadMetadata": {
          "labels": {
            "runai/queue": "test-queue"
          }
        }
      }
    },
    "orchestration": {
      "target": {},
      "placement": "Unpinned",
      "execution": {
        "maxConcurrent": 1,
        "timeoutPerJob": "20m0s"
      },
      "iterations": 1
    },
    "dependencies": [
      {
        "apiVersion": "v1",
        "data": {
          "probe.py": "# SPDX-FileCopyrightText: Copyright (c) 2026 NVIDIA CORPORATION \u0026 AFFILIATES. All rights reserved.\n# SPDX-License-Identifier: Apache-2.0\n\nimport json\nimport os\nimport time\nimport urllib.error\nimport urllib.request\n\n\ndef main():\n    url = (os.environ.get('VLLM_URL') or ('http://' + os.environ['VLLM_SERVICE'] + ':8000')).rstrip('/')\n    model = os.environ.get('VLLM_MODEL', 'Qwen/Qwen2.5-0.5B-Instruct')\n    timeout = int(os.environ.get('TIMEOUT_SECONDS', '600'))\n    if timeout \u003c= 0:\n        raise ValueError('TIMEOUT_SECONDS must be positive')\n    deadline = time.monotonic() + timeout\n    while True:\n        try:\n            with urllib.request.urlopen(url + '/health', timeout=min(10, timeout)) as response:\n                if response.status == 200:\n                    break\n        except (OSError, urllib.error.URLError):\n            pass\n        if time.monotonic() \u003e= deadline:\n            raise TimeoutError('vLLM did not become healthy before the deadline')\n        time.sleep(min(2, max(0, deadline - time.monotonic())))\n    request = urllib.request.Request(\n        url + '/v1/chat/completions',\n        data=json.dumps({'model': model, 'messages': [{'role': 'user', 'content': 'What is 2 + 2?'}],\n                         'max_tokens': 32, 'temperature': 0}).encode(),\n        headers={'Content-Type': 'application/json'}, method='POST')\n    remaining = deadline - time.monotonic()\n    if remaining \u003c= 0:\n        raise TimeoutError('inference probe deadline expired before the request')\n    with urllib.request.urlopen(request, timeout=min(60, remaining)) as response:\n        result = json.load(response)\n    choices = result.get('choices', [])\n    if not choices or not choices[0].get('message', {}).get('content', '').strip():\n        raise ValueError('chat completion returned no assistant content')\n    print(json.dumps({'model': model, 'status': 'passed'}), flush=True)\n\n\nif __name__ == '__main__':\n    main()\n"
        },
        "kind": "ConfigMap",
        "metadata": {
          "name": "vllm-single-probe"
        }
      },
      {
        "apiVersion": "v1",
        "kind": "Service",
        "metadata": {
          "name": "vllm-single-service"
        },
        "spec": {
          "ports": [
            {
              "name": "http",
              "port": 8000,
              "targetPort": 8000
            }
          ],
          "selector": {
            "nvcre-vllm-server": "vllm-single"
          }
        }
      },
      {
        "apiVersion": "run.ai/v2alpha1",
        "kind": "InferenceWorkload",
        "metadata": {
          "labels": {
            "runai/queue": "test-queue"
          },
          "name": "vllm-single-server"
        },
        "spec": {
          "arguments": {
            "value": "'--model' 'Qwen/Qwen2.5-0.5B-Instruct' '--port' '8000'"
          },
          "cpu": {
            "value": "1"
          },
          "gpuDevices": {
            "value": 1
          },
          "image": {
            "value": "vllm/vllm-openai:v0.29.0@sha256:c2914767605584b6d8f45686b82de173ecc99e781897aa3d0a66dacd72c51ae1"
          },
          "imagePullSecrets": {
            "value": "test-pull"
          },
          "labels": {
            "items": {
              "nvcre-vllm-server": {
                "value": "vllm-single"
              }
            }
          },
          "maxScale": {
            "value": 1
          },
          "memory": {
            "value": "4Gi"
          },
          "memoryLimit": {
            "value": "12Gi"
          },
          "minScale": {
            "value": 1
          },
          "ports": {
            "items": {
              "http": {
                "value": {
                  "container": 8000,
                  "protocol": "http",
                  "serviceType": "ServingPort"
                }
              }
            }
          },
          "readinessProbe": {
            "values": {
              "httpGetPath": {
                "value": "/health"
              },
              "httpGetPort": {
                "value": 8000
              },
              "periodSeconds": {
                "value": 5
              },
              "timeoutSeconds": {
                "value": 2
              }
            }
          }
        }
      }
    ]
  }
}